{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"outDir": "dist-test",
		"rootDir": ".",
		"declaration": false,
		"sourceMap": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"verbatimModuleSyntax": false
	},
	"include": ["index.ts", "src/**/*.ts", "test/**/*.ts"]
}
